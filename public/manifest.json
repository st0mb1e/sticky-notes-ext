{
    "name": "Sticky Notes",
    "manifest_version": 3,
    "version": "1.0.0",
    "permissions": ["tabs"],
    "action": {
        "default_popup": "index.html"
    },
    "background": {
        "service_worker": "assets/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["assets/content.js"]
        }
    ]
}
